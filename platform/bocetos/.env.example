# Configuracion privada local: copiar a .env.local y completar fuera de Git.
OPENAI_API_KEY=
# Respaldo compartido para rechazos de autenticacion o cuota.
OPENAI_API_KEY_FALLBACK=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_COLOR_MODEL=gpt-4.1-mini
PORT=4318
# Panel local por empresa (sin publicar): true y PORT=4319.
SPORTEX_LAB_MANAGED=false
# Solo para consultar cargos oficiales desde el servidor.
OPENAI_ADMIN_KEY=
# IDs opcionales para filtrar el reporte oficial a las dos claves compartidas.
# Sin IDs, el reporte corresponde a toda la organizacion de OpenAI.
OPENAI_API_KEY_ID=
OPENAI_API_KEY_FALLBACK_ID=
