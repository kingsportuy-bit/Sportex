{
  "name": "@sportex/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build:test && node --test --experimental-test-isolation=none dist-test/tests/**/*.test.js",
    "validate-sql": "node scripts/validate-sql.mjs",
    "build:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@fastify/static": "^10.1.0",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
