SPORTEX_ENV=development
SPORTEX_STORE=memory
SPORTEX_DEV_AUTH=true
SPORTEX_TABLE_PREFIX=sportex_staging_
SPORTEX_RELEASE=local
SPORTEX_FRONTEND_DIR=../frontend
HOST=127.0.0.1
PORT=8080

# PostgreSQL. En STAGING usar DATABASE_URL_FILE con un Docker secret.
# DATABASE_URL=postgresql://sportex_staging_runtime:password@db:5432/postgres
# DATABASE_URL_FILE=/run/secrets/database_url
# SPORTEX_DATABASE_ROLE=sportex_staging_app

# Supabase Auth. La anon key es pública para el login, pero se monta como secret
# para mantener un único mecanismo de configuración del stack.
# SPORTEX_AUTH_INTERNAL_URL=http://auth:9999
# SPORTEX_AUTH_PUBLIC_URL=https://supabase-staging.codexa.uy/auth/v1
# SPORTEX_AUTH_ANON_KEY=eyJ...
# SPORTEX_AUTH_ANON_KEY_FILE=/run/secrets/auth_anon_key
# SPORTEX_AUTH_TIMEOUT_MS=5000
